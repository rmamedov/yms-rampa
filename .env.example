# Доступи до стенду YMS «Рампа».
#
# Скопіюйте у .env і підставте свої значення, або задайте змінні в оболонці.
# Файл .env у git не потрапляє (див. .gitignore).
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a
#
# Паролі свідомо НЕ мають значень за замовчуванням: скрипт має впасти з
# зрозумілим повідомленням, а не мовчки підставити чужий доступ.

# --- Стенд ---------------------------------------------------------------
# Адреса секретом не є; піддомени будуються від неї (admin./yms./driver./store.).
YMS_IP=104.248.132.130

# --- Контур співробітників мережі (адмін-панель і модуль магазину) --------
YMS_ADMIN_EMAIL=admin@rampa.ua
YMS_ADMIN_PASSWORD=

# --- Контур партнерів (кабінет постачальника) ----------------------------
YMS_SUPPLIER_LOGIN=supplier@rampa.ua
YMS_SUPPLIER_PASSWORD=

# --- Розгортання (infra/deploy.sh, infra/deploy-api.sh) -------------------
# YMS_HOST=root@104.248.132.130
# YMS_SSH_KEY=~/.ssh/id_droplet

# --- Прогін тестів проти локальних прод-збірок ---------------------------
# Задавайте, лише якщо перевіряєте збірку до розгортання на стенд.
# ADMIN_HOST=http://localhost:4300
# SUPPLIER_HOST=http://localhost:4301
# DRIVER_HOST=http://localhost:4302
# STORE_HOST=http://localhost:4303
